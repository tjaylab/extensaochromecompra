# --- Local development (no external services) ---------------------------------
# Copy to .env. With these values the API runs with embedded PGlite, e-mail-only
# login, a local heuristic instead of Claude, and a simulated Omie.
AUTH_MODE=dev
OMIE_MODE=mock
EXTRACTION_MODE=mock
PGLITE_DIR=./.data/pglite
PORT=8787
HOST=127.0.0.1

# --- Pilot / production (Supabase + Claude + Omie) ------------------------------
# NODE_ENV=production
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# AUTH_MODE=supabase
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_JWT_SECRET=            # only for projects still on the legacy HS256 secret; empty = JWKS
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_WORKSPACE_ID=        # needed when the key is not scoped to a workspace
# EXTRACTION_MODE=claude
# CLAUDE_MODEL=claude-opus-5
# CLAUDE_EFFORT=low
# OMIE_MODE=live
# ENCRYPTION_KEY=                 # node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# CORS_ORIGINS=chrome-extension://<extension id>

# E-mail do pedido ao fornecedor (resend.com). Sem isso, o painel abre o e-mail do comprador.
RESEND_API_KEY=
EMAIL_FROM=

# Planos e cobrança (asaas.com). Sem ASAAS_API_KEY em produção, o pagamento online fica desligado
# e a equipe ProcureMate marca os pagamentos à mão no Painel ProcureMate.
ASAAS_API_KEY=
ASAAS_ENV=sandbox
# Token definido no webhook do Asaas (URL: https://<sua-api>/webhooks/asaas)
ASAAS_WEBHOOK_TOKEN=
# E-mails da equipe ProcureMate (veem o Painel ProcureMate), separados por vírgula
SUPERADMIN_EMAILS=
