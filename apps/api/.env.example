# --- Local development (no external services) ---------------------------------
# Copy to .env. With these values the API runs with embedded PGlite, e-mail-only
# login, a local heuristic instead of Claude, and a simulated Omie.
AUTH_MODE=dev
OMIE_MODE=mock
EXTRACTION_MODE=mock
PGLITE_DIR=./.data/pglite
PORT=8787
HOST=127.0.0.1

# --- Pilot / production (Supabase + Claude + Omie) ------------------------------
# NODE_ENV=production
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# AUTH_MODE=supabase
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_JWT_SECRET=            # only for projects still on the legacy HS256 secret; empty = JWKS
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_WORKSPACE_ID=        # needed when the key is not scoped to a workspace
# EXTRACTION_MODE=claude
# CLAUDE_MODEL=claude-opus-5
# CLAUDE_EFFORT=low
# OMIE_MODE=live
# ENCRYPTION_KEY=                 # node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# CORS_ORIGINS=chrome-extension://<extension id>
